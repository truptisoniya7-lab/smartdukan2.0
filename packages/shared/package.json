{
  "name": "@smart-dukan/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Zod schemas, types and constants for Smart Dukan",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@smart-dukan/tsconfig": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.2"
  }
}
