# Copy this file to .env and fill in the values
# DO NOT commit real secrets to git

NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# Database
DATABASE_URL="postgresql://smartdukan:smartdukan_dev@localhost:5432/smartdukan?schema=public"

# Redis
REDIS_URL="redis://:smartdukan_redis@localhost:6379"

# JWT (generate with: node -e "require('crypto').generateKeyPairSync('rsa',{modulusLength:2048}).privateKey.export({type:'pkcs8',format:'pem'})|fs.writeFileSync('private.pem',...)")
JWT_PRIVATE_KEY_PATH="./keys/private.pem"
JWT_PUBLIC_KEY_PATH="./keys/public.pem"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="smartdukan"
S3_SECRET_KEY="smartdukan_minio"
S3_BUCKET="smartdukan-media"
S3_REGION="ap-south-1"

# Razorpay
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# SMS / OTP (MSG91)
MSG91_AUTH_KEY="..."
MSG91_TEMPLATE_ID="..."

# CORS
CORS_ORIGIN="http://localhost:5173"

# Frontend
VITE_API_URL="http://localhost:4000/api/v1"
VITE_WS_URL="http://localhost:4000"
